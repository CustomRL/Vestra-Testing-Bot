{
  "name": "vestra-testing-bot",
  "version": "0.0.0",
  "description": "A live Discord bot that exercises the Vestra library against the real gateway",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node src/index.ts",
    "typecheck": "tsc --noEmit",
    "check:compression": "node scripts/compression-check.ts",
    "check:resume": "node scripts/resume-check.ts",
    "check:transport": "node scripts/transport-check.ts"
  },
  "dependencies": {
    "vestra": "link:../Vestra/packages/vestra"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "typescript": "6.0.3"
  }
}

# The bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Optional. Comma-separated intent names from GatewayIntentBits.
# Defaults to Guilds,GuildMessages,MessageContent.
# MessageContent, GuildMembers and GuildPresences are privileged and must be
# enabled on the Bot page of the developer portal first.
# DISCORD_INTENTS=Guilds,GuildMessages,MessageContent

# Optional. Overrides Discord's recommended shard count.
# DISCORD_SHARD_COUNT=1

# Optional. Prefix the command handler listens for. Defaults to "!".
# COMMAND_PREFIX=!
